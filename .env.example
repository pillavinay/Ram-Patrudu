# Copy this file to `.env.local` for local development.
# On GitHub, add these under: Repo → Settings → Secrets and variables → Actions → Variables.

# The live address of the website (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://rampatrudu.com

# Contact form: free access key from https://web3forms.com (enter the email that should receive messages)
# Leave empty and the form will show a friendly "not connected yet" message.
NEXT_PUBLIC_WEB3FORMS_KEY=
